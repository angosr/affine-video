FROM pytorch/pytorch@sha256:6961740947d7eb3a2f25ce6a6f28aff6383a48d3ceec56257d5e9ebc02d3b92c

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --no-build-isolation \
    "flash-attn-4 @ git+https://github.com/Dao-AILab/flash-attention@d15f1531a460ba456f41b01a774f33ab2db8febf#subdirectory=flash_attn/cute"

RUN git init /tmp/Miowtion \
    && git -C /tmp/Miowtion remote add origin https://github.com/veda-sparse/Miowtion.git \
    && git -C /tmp/Miowtion fetch --depth 1 origin ffbb4c29d9b1f19f026dec0c0485840fffe4639f \
    && git -C /tmp/Miowtion checkout --detach FETCH_HEAD \
    && python -m pip install --no-cache-dir "/tmp/Miowtion[encode]" \
    && rm -rf /tmp/Miowtion

COPY . /tmp/veda
RUN python -m pip install --no-cache-dir "/tmp/veda[storage]" \
    && rm -rf /tmp/veda

# The pinned Miowtion Top-k did not specify tie order. Match the authoritative
# scorer's ascending key-index tie break; these installed bytes are bound by
# both the source bundle and the dependency lock generated inside this image.
RUN python - <<'PY'
from pathlib import Path
from miowtion.veda import mask

path = Path(mask.__file__)
source = path.read_text()
old = "        vals, idx = torch.topk(s, k_hi, dim=-1, sorted=True)"
new = (
    "        idx = torch.argsort(s, dim=-1, descending=True, stable=True)[..., :k_hi]\n"
    "        vals = torch.gather(s, -1, idx)"
)
if source.count(old) != 1:
    raise RuntimeError("pinned Miowtion mask source differs from the audited patch target")
path.write_text(source.replace(old, new))
PY

WORKDIR /work
ENTRYPOINT ["veda"]
